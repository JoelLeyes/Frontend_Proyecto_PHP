APP_NAME=ServiciosProFrontend
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:5173

# URL del backend Laravel API
VITE_API_URL=https://api.agendaonline.cloud-ip.cc

# Client IDs públicos para construir el login social directo desde la SPA
VITE_GOOGLE_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=
VITE_FACEBOOK_CLIENT_ID=

# PayPal Client ID (sandbox o live — desde developer.paypal.com)
VITE_PAYPAL_CLIENT_ID=

# LiveKit (para videollamadas en el cliente)
VITE_LIVEKIT_URL=

# WebSockets (Laravel Reverb)
VITE_REVERB_APP_KEY=your-app-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
